# ---------------------------------------------------------------------------
# Bay Six - environment example. PLACEHOLDERS ONLY. Never commit a real key.
# Copy to .env.local and fill in.
# ---------------------------------------------------------------------------

# --- Rime (REQUIRED: primary spoken output) --------------------------------
# Get one at https://rime.ai . Server-side only; never exposed to the browser.
RIME_API_KEY=rime_sk_REPLACE_ME

# Exact shipped configuration. Validated against Rime's LIVE catalog by
# `npm run preflight` -- do not hand-edit these to a speaker you have not
# preflighted.
RIME_MODEL_ID=coda
RIME_SPEAKER=astra
RIME_LANG=en
RIME_AUDIO_FORMAT=pcm
RIME_SAMPLING_RATE=24000
RIME_SEGMENT=immediate

# Transport. ws3 is the JSON WebSocket API: it is the only Rime transport that
# exposes `operation: clear` (server-side barge-in) and `contextId` (stale-audio
# fencing). Both are load-bearing for this project -- see RIME_EVIDENCE.md.
RIME_WS_URL=wss://users-ws.rime.ai/ws3
# Regional/self-hosted deployments: override the two below together.
RIME_HTTP_URL=https://users.rime.ai/v1/rime-tts
RIME_CATALOG_URL=https://users.rime.ai/data/voices/all-v2.json

# --- Reasoning (OPTIONAL) --------------------------------------------------
# Without this the app runs on a deterministic scripted planner so judges can
# reproduce every voice behaviour with a Rime key alone. The active planner is
# shown in the on-screen HUD.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
ANTHROPIC_MODEL=claude-opus-5

# --- Stress-test controls (used by the demo + acceptance tests) ------------
# Artificial latency injected into the parts-catalog tool, in ms. The brief's
# full-duplex test requires "a fixed delay in a tool call".
BAY6_TOOL_DELAY_MS=3000

PORT=3000
